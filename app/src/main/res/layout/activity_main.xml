<?xml version="1.0" encoding="utf-8"?>
<!--
  Ten-foot UI: large type, generous padding, and an explicit D-pad focus chain so
  remote navigation is deterministic rather than left to the focus finder.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101216"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_wifi"
            style="@style/Body"
            android:layout_marginTop="16dp" />

        <TextView android:id="@+id/txt_guard" style="@style/Body" />

        <TextView android:id="@+id/txt_snooze" style="@style/Body" />

        <TextView android:id="@+id/txt_stats" style="@style/Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_toggle"
                style="@style/Action"
                android:nextFocusRight="@+id/btn_probe">
                <requestFocus />
            </Button>

            <Button
                android:id="@+id/btn_probe"
                style="@style/Action"
                android:nextFocusLeft="@+id/btn_toggle"
                android:nextFocusRight="@+id/btn_test"
                android:text="@string/btn_probe" />

            <Button
                android:id="@+id/btn_test"
                style="@style/Action"
                android:nextFocusLeft="@+id/btn_probe"
                android:nextFocusRight="@+id/btn_snooze"
                android:text="@string/btn_test" />

            <Button
                android:id="@+id/btn_snooze"
                style="@style/Action"
                android:nextFocusLeft="@+id/btn_test"
                android:nextFocusRight="@+id/btn_clear"
                android:text="@string/btn_snooze" />

            <Button
                android:id="@+id/btn_clear"
                style="@style/Action"
                android:nextFocusLeft="@+id/btn_snooze"
                android:text="@string/btn_clear" />
        </LinearLayout>

        <TextView
            style="@style/Heading"
            android:text="@string/heading_diag" />

        <TextView
            android:id="@+id/txt_diag"
            style="@style/Mono" />

        <TextView
            style="@style/Heading"
            android:text="@string/heading_events" />

        <TextView
            android:id="@+id/txt_events"
            style="@style/Mono" />
    </LinearLayout>
</ScrollView>
