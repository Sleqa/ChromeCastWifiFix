    <string name="probe_title">Capability check</string>
    <string name="probe_needs_wifi_on">Turn Wi-Fi on first — this check only runs when the radio is already on, so it can never leave you offline.</string>
    <string name="probe_accepted">The framework accepted the call. On Android 13 and later a "true" can also mean a confirmation dialog was posted instead, so the watchdog still waits for the radio to actually report ENABLED before calling it a success.</string>
    <string name="probe_rejected">The framework rejected the call. Tier 1 will not work on this device — check targetSdk and the app-op above.</string>

    <string name="test_title">Test the fix</string>
    <string name="test_warning">This switches Wi-Fi off on purpose and lets the watchdog put it back.\n\nIf the repair fails you will need the remote to turn Wi-Fi back on, and ADB will be unreachable until you do.\n\nA separate one-minute alarm is armed first as a safety net.</string>
    <string name="test_confirm">Turn Wi-Fi off</string>

